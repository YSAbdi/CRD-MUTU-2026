APP_NAME="CRM Camp Resident MUTU"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=crm_mutu
DB_USERNAME=root
DB_PASSWORD=

CACHE_STORE=file
QUEUE_CONNECTION=database
SESSION_DRIVER=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# Gunakan argon jika PHP server mendukungnya, atau bcrypt sebagai fallback Laravel.
HASH_DRIVER=argon
